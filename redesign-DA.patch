+  'from-brand-800 to-brand-600',
+];
+
+function gradientFor(iata: string): string {
+  const sum = iata.split('').reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
+  return GRADIENT_VARIANTS[sum % GRADIENT_VARIANTS.length];
+}
 
